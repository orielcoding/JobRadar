# סודות – הקובץ הזה נשאר רק אצלך. `jobradar init` יוצר ממנו .env.

# נושא פרטי ב-ntfy (נוצר אוטומטית ב-init). כל מי שיודע את השם יכול לקרוא את ההתראות – אל תשתף.
NTFY_TOPIC=

# טוקן לשנה מ-`claude setup-token` (מומלץ להרצה מתוזמנת). ריק = ההתחברות הרגילה של Claude Code.
CLAUDE_CODE_OAUTH_TOKEN=

# סיסמת אפליקציה של Google (רק אם gmail.enabled או ערוץ email). 16 תווים, אפשר עם רווחים.
GMAIL_APP_PASSWORD=

# אופציונלי: טלגרם במקום/בנוסף ל-ntfy
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# אופציונלי: לאן לשלוח בערוץ email (ברירת מחדל: gmail.user)
NOTIFY_EMAIL_TO=
